<div id="TcHmiAdsState_PLC" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiAdsState" data-tchmi-ads-runtime="%pp%PlcAdsTargetName%/pp%" data-tchmi-text-font-weight="Bold" data-tchmi-text-font-size="20" data-tchmi-server-interval="500" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-height-mode="Value" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-tooltip="press to toggle START/STOP PLC State">
{
  "Config": "%tr%PLC_Config%/tr%",
  "Exception": "%tr%PLC_Exception%/tr%",
  "Fallback": "%tr%PLC_Fallback%/tr%",
  "Run": "%tr%PLC_Run%/tr%",
  "Stop": "%tr%PLC_Stop%/tr%"
}






















<script data-tchmi-target-attribute="data-tchmi-state-images" type="application/json">
{
  "Config": "%tr%PLC_Config%/tr%",
  "Exception": "%tr%PLC_Exception%/tr%",
  "Fallback": "%tr%PLC_Fallback%/tr%",
  "Run": "%tr%PLC_Run%/tr%",
  "Stop": "%tr%PLC_Stop%/tr%"
}
</script>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "ControlApiFunction",
        "active": true,
        "control": "TcHmiPopup_PLC",
        "fn": "open",
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "function togglePlc1State() {",
          "    TcHmi.Server.writeSymbol(",
          "        'ADS.AdsSyncReadStateReq',",
          "        'PLC1',",
          "        data => {",
          "            // Check the read request for errors.",
          "            if (",
          "                data.error !== TcHmi.Errors.NONE ||",
          "                !data.response ||",
          "                data.response.error ||",
          "                !data.response.commands ||",
          "                data.response.commands[0].error",
          "            ) {",
          "                console.error('Failed to read PLC1 ADS state:', data);",
          "                return;",
          "            }",
          "",
          "            currentState =",
          "                data.response.commands[0].readValue;",
          "",
          "            let targetState;",
          "",
          "            if (currentState === 5) {",
          "                targetState = 6; // RUN -> STOP",
          "            } else if (currentState === 6) {",
          "                targetState = 5; // STOP -> RUN",
          "            } else {",
          "                console.warn(",
          "                    'PLC1 is in an unsupported ADS state:',",
          "                    currentState",
          "                );",
          "                return;",
          "            }",
          "",
          "            // Request the state transition.",
          "            TcHmi.Server.writeSymbol(",
          "                'ADS.AdsSyncWriteControlReq',",
          "                {",
          "                    AdsState: targetState,",
          "                    DeviceState: 0,",
          "                    Runtime: 'PLC1',",
          "                    WriteData: ''",
          "                },",
          "                writeData => {",
          "                    if (",
          "                        writeData.error !== TcHmi.Errors.NONE ||",
          "                        !writeData.response ||",
          "                        writeData.response.error ||",
          "                        !writeData.response.commands ||",
          "                        writeData.response.commands[0].error",
          "                    ) {",
          "                        console.error(",
          "                            'Failed to change PLC1 ADS state:',",
          "                            writeData",
          "                        );",
          "                        return;",
          "                    }",
          "",
          "                    console.info(",
          "                        'Requested PLC1 ADS state:',",
          "                        targetState",
          "                    );",
          "                }",
          "            );",
          "        }",
          "    );",
          "}"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>















<script data-tchmi-target-attribute="data-tchmi-grid-layout" type="application/json">
{
  "columnGap": 5.0,
