<div id="TcHmiAdsState_TcSys" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiAdsState" data-tchmi-ads-runtime="%pp%XarAdsTargetName%/pp%" data-tchmi-text-font-weight="Bold" data-tchmi-text-font-size="20" data-tchmi-server-interval="500" data-tchmi-creator-visibility="Visible" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-height-mode="Value" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-tooltip="press to toggle RUN/CONFIG XAR State">
<script data-tchmi-target-attribute="data-tchmi-state-images" type="application/json">
{
  "Config": "%tr%TwinCAT_Config%/tr%",
  "Exception": "%tr%TwinCAT_Exception%/tr%",
