				<Parameter HideParameter="true" Group="General">
					<Name>Maximal position</Name>
					<Comment><![CDATA[Mover maximal position. For the c coordinate the interpretation is not absolute.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
