			</Licenses>
			<Parameters>
				<Group Collapsed="true"><![CDATA[General]]></Group>
				<Group Collapsed="true"><![CDATA[Simulation]]></Group>
				<Group Collapsed="true"><![CDATA[Hardware]]></Group>
