					<Unit><![CDATA[mm, °]]></Unit>
					<PTCID>#x050300b5</PTCID>
				</Parameter>
				<Parameter HideParameter="true" Group="General">
					<Name>Minimal position</Name>
					<Comment><![CDATA[Mover minimal position. For the c coordinate the interpretation is not absolute.]]></Comment>
