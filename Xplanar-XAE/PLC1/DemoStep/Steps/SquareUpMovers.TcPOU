    <Method Name="CyclicLogic" Id="{13e63152-bec4-4910-9c94-57f285c6c0e7}">
      <Declaration><![CDATA[METHOD CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Mover.MoveCommand.SquareUp().Done AND Mover2.MoveCommand.SquareUp().Done THEN
			Done:=TRUE;
ELSIF Mover.MoveCommand.SquareUp().Error OR Mover2.MoveCommand.SquareUp().Error THEN
			Step:=E_DemoStep.Disable;
		END_IF]]></ST>
      </Implementation>
    </Method>
