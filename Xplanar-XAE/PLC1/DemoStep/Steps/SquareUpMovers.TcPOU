  <POU Name="SquareUpMovers" Id="{0243f4e0-eb69-4642-bd5b-6056700c9759}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SquareUpMovers EXTENDS FB_DemoStepBase IMPLEMENTS I_TwoMovers
