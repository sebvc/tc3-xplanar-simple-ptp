{
  "$schema": "../.hmiframework/Schema/ControlDescription.Schema.json",
  "apiVersion": 1,
  "name": "XPlanarView",
  "namespace": "TcHmi.Controls.XPlanarView",
  "displayName": "XPlanarView",
  "version": {
    "full": "1.1.2.0",
    "major": 1,
    "minor": 1,
    "revision": 2,
    "build": 0
  },
  "visible": true,
  "themeable": "Standard",
  "base": "TcHmi.Controls.System.TcHmiControl",
  "description": "View an XPlanar System",
  "properties": {
    "containerControl": false,
    "geometry": {
      "width": 150,
      "height": 150
    }
  },
  "icons": [
    {
      "name": "Icons/XPlanarIcon.png",
      "width": 16,
      "height": 16
    }
  ],
  "template": "Template.html",
  "dependencyFiles": [
    {
      "name": "XPlanarView.js",
      "type": "JavaScript",
      "description": "Contains all the main logic."
    },
    {
      "name": "Style.css",
      "type": "Stylesheet",
      "description": "Theme independent style"
    }
  ],
    "themes": {
        "Base": {
            "resources": [
                {
                    "name": "Themes/Base/Style.css",
                    "type": "Stylesheet",
                    "description": "Theme dependent style"
                }
            ]
        },
        "Base-Dark": {
            "resources": [
                {
                    "name": "Themes/Base-Dark/Style.css",
                    "type": "Stylesheet",
                    "description": "Theme dependent style"
                }
            ]
        }
    },
  "attributes": [
    {
      "name": "data-tchmi-tile-config",
      "propertyName": "TileConfig",
      "propertySetterName": "setTileConfig",
      "propertyGetterName": "getTileConfig",
      "displayName": "TileConfig",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.XPlanarView.XPlanarView.TileConfig",
      "category": "Common",
      "description": "An array containing positions and sizes of tiles. Tile Config data must match below naming - \n { \n\tX: number, \n\tY: number, \n\tWidth: number, \n\tHeight: number \n }",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": []
    },
    {
      "name": "data-tchmi-mover-info",
      "propertyName": "MoverInfo",
      "propertySetterName": "setMoverInfo",
      "propertyGetterName": "getMoverInfo",
      "displayName": "MoverInfo",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.XPlanarView.XPlanarView.MoverInfo",
      "category": "Common",
      "description": "An array containing mover sizes and BTNs. Mover Info data must match below naming - \n { \n\tWidth: number, \n\tHeight: number, \n\tMoverBTN: string \n }",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": []
    },
    {
      "name": "data-tchmi-mover-vector-data",
      "propertyName": "MoverVectorData",
      "propertySetterName": "setMoverVectorData",
      "propertyGetterName": "getMoverVectorData",
      "displayName": "MoverVectorData",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/Symbol",
      "category": "Common",
      "description": "Symbol containing mover vectors. Mover Vector data must match below naming - \n { \n\tx: number, \n\ty: number, \n\tz: number, \n\tc: number \n }",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-refresh-rate",
      "propertyName": "RefreshRate",
      "propertySetterName": "setRefreshRate",
      "propertyGetterName": "getRefreshRate",
      "displayName": "RefreshRate",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Number",
      "category": "Common",
      "description": "Interval in ms at which the control gets new vector data from the server. 100 ms is default and recommended. Higher numbers will be choppy and lower numbers may put a heavier load on the network.",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": 100
    },
    {
      "name": "data-tchmi-station-layout",
      "propertyName": "StationLayout",
      "propertySetterName": "setStationLayout",
      "propertyGetterName": "getStationLayout",
      "displayName": "StationLayout",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.XPlanarView.XPlanarView.StationLayout",
      "category": "Common",
      "description": "An array containing positions and sizes of stations. Station Layout data must match below naming - \n { \n\tX: number, \n\tY: number, \n\tWidth: number, \n\tHeight: number \n }",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": []
    },
    {
      "name": "data-tchmi-scale-to-fit",
      "propertyName": "ScaleToFit",
      "propertySetterName": "setScaleToFit",
      "propertyGetterName": "getScaleToFit",
      "displayName": "ScaleToFit",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": true
    },
    {
      "name": "data-tchmi-rotate",
      "propertyName": "Rotate",
      "propertySetterName": "setRotate",
      "propertyGetterName": "getRotate",
      "displayName": "Rotate",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "If set, the track will rotate 90 degrees clockwise.",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-display-mover-btn",
      "propertyName": "DisplayMoverBTN",
      "propertySetterName": "setDisplayMoverBTN",
      "propertyGetterName": "getDisplayMoverBTN",
      "displayName": "DisplayMoverBTN",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "If set, movers will display their BTN.",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-display-custom-text",
      "propertyName": "DisplayCustomText",
      "propertySetterName": "setDisplayCustomText",
      "propertyGetterName": "getDisplayCustomText",
      "displayName": "DisplayCustomText",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "If set, movers will display custom text, if any exists.",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-smooth-motion",
      "propertyName": "SmoothMotion",
      "propertySetterName": "setSmoothMotion",
      "propertyGetterName": "getSmoothMotion",
      "displayName": "SmoothMotion",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "If set, animation interpolation will be used to smooth mover motion. This will lock server data refresh rate at 100ms and ignore any value set in the RefreshRate property.",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": true
    },
    {
      "name": "data-tchmi-use-mover-image",
      "propertyName": "UseMoverImage",
      "propertySetterName": "setUseMoverImage",
      "propertyGetterName": "getUseMoverImage",
      "displayName": "UseMoverImage",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "Common",
      "description": "Toggle to switch between using a mover image or a graphically drawn mover (if mover image file fails to load, graphically drawn mover will be used as a fallback).",
      "readOnly": false,
      "bindable": true,
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-selected-mover-index",
      "propertyName": "SelectedMoverIndex",
      "propertySetterName": "setSelectedMoverIndex",
      "propertyGetterName": "getSelectedMoverIndex",
      "displayName": "SelectedMoverIndex",
      "visible": true,
      "themeable": "Advanced",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Number",
      "category": "Data",
      "description": "Currently selected mover (guaranteed zero based)",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-font-size",
      "propertyName": "FontSize",
      "propertySetterName": "setFontSize",
      "propertyGetterName": "getFontSize",
      "displayName": "FontSize",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 20,
      "type": "tchmi:framework#/definitions/MeasurementValue",
      "category": "Text",
      "description": "The size of the font. Percent values are relative to the parent elements font size.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-font-size-unit",
      "propertyName": "FontSizeUnit",
      "propertySetterName": "setFontSizeUnit",
      "propertyGetterName": "getFontSizeUnit",
      "refTo": "FontSize",
      "displayName": "FontSizeUnit",
      "visible": true,
      "themeable": "Advanced",
      "displayPriority": 20,
      "type": "tchmi:framework#/definitions/MeasurementUnit",
      "category": "Text",
      "description": "Could be 'px' or for relative sizing '%'.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": "px"
    }
  ],
  "attributeCategories": [
    {
      "name": "Data",
      "displayPriority": 500,
      "defaultCollapsed": true,
      "description": "Attributes defining the data the control is showing."
    },
    {
      "name": "Text",
      "displayPriority": 600,
      "defaultCollapsed": true,
      "description": "Configuration of font size for displayed text."
    }
  ],
  "functions": [],
  "events": [
    {
      "name": ".onSelectedMoverChanged",
      "displayName": ".onSelectedMoverChanged",
      "visible": true,
      "displayPriority": 7,
      "category": "Operator",
      "description": "The Selected Mover Changed event fires when the user selects a new mover or deselects a mover in the viewer.",
      "heritable": true
    }
  ],
  "dataTypes": [
    {
      "schema": "Schema/Types.Schema.json"
    }
  ]
}