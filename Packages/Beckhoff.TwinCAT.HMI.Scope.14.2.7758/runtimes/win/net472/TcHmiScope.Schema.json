{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "polygon": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "fullPolygon": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "polygon": {
          "$ref": "#/definitions/polygon"
        }
      }
    },
    "grid": {
      "type": "object",
      "properties": {
        "ticks": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number"
        }
      },
      "required": [
        "ticks",
        "color",
        "lineWidth"
      ]
    },
    "overview": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "dimensions": {
          "$ref": "#/definitions/dimensions"
        },
        "preferredSize": {
          "$ref": "#/definitions/dimensions"
        },
        "position": {
          "$ref": "#/definitions/position"
        },
        "canvas": {
          "type": "object",
          "properties": {
            "dimensions": {
              "$ref": "#/definitions/dimensions"
            },
            "position": {
              "$ref": "#/definitions/position"
            },
            "backgroundColor": {
              "type": "string"
            }
          }
        },
        "verticalAxis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "visibleTicks": {
                "type": "boolean"
              },
              "dimensions": {
                "$ref": "#/definitions/dimensions"
              },
              "position": {
                "$ref": "#/definitions/position"
              },
              "color": {
                "type": "string"
              },
              "lineWidth": {
                "type": "number"
              },
              "headline": {
                "type": "object",
                "properties": {
                  "dimensions": {
                    "$ref": "#/definitions/dimensions"
                  },
                  "position": {
                    "$ref": "#/definitions/position"
                  },
                  "label": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "fontSize": {
                    "type": "number"
                  }
                },
                "required": [
                  "dimensions",
                  "position",
                  "label",
                  "color",
                  "fontSize"
                ]
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimensions": {
                      "$ref": "#/definitions/dimensions"
                    },
                    "position": {
                      "$ref": "#/definitions/position"
                    },
                    "label": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "fontSize": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "dimensions",
                    "position",
                    "label",
                    "color",
                    "fontSize"
                  ]
                }
              },
              "grid": {
                "type": "object",
                "properties": {
                  "ticks": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "lineWidth": {
                    "type": "number"
                  }
                },
                "required": [
                  "ticks",
                  "color",
                  "lineWidth"
                ]
              },
              "subGrid": {
                "type": "object",
                "properties": {
                  "ticks": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "lineWidth": {
                    "type": "number"
                  }
                },
                "required": [
                  "ticks",
                  "color",
                  "lineWidth"
                ]
              }
            },
            "required": [
              "visible",
              "dimensions",
              "position"
            ]
          }
        },
        "horizontalAxis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "visibleTicks": {
                "type": "boolean"
              },
              "dimensions": {
                "$ref": "#/definitions/dimensions"
              },
              "position": {
                "$ref": "#/definitions/position"
              },
              "color": {
                "type": "string"
              },
              "lineWidth": {
                "type": "number"
              },
              "headline": {
                "type": "object",
                "properties": {
                  "dimensions": {
                    "$ref": "#/definitions/dimensions"
                  },
                  "position": {
                    "$ref": "#/definitions/position"
                  },
                  "label": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "fontSize": {
                    "type": "number"
                  }
                },
                "required": [
                  "dimensions",
                  "position",
                  "label",
                  "color",
                  "fontSize"
                ]
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimensions": {
                      "$ref": "#/definitions/dimensions"
                    },
                    "position": {
                      "$ref": "#/definitions/position"
                    },
                    "label": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "fontSize": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "dimensions",
                    "position",
                    "label",
                    "color",
                    "fontSize"
                  ]
                }
              },
              "grid": {
                "type": "object",
                "properties": {
                  "visible": {
                    "type": "boolean"
                  },
                  "ticks": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "lineWidth": {
                    "type": "number"
                  }
                },
                "required": [
                  "visible",
                  "ticks",
                  "color",
                  "lineWidth"
                ]
              },
              "subGrid": {
                "type": "object",
                "properties": {
                  "visible": {
                    "type": "boolean"
                  },
                  "ticks": {
                    "dimensions": {
                      "$ref": "#/definitions/dimensions"
                    },
                    "position": {
                      "$ref": "#/definitions/position"
                    },
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "lineWidth": {
                    "type": "number"
                  }
                },
                "required": [
                  "visible",
                  "ticks",
                  "color",
                  "lineWidth"
                ]
              }
            },
            "required": [
              "visible",
              "dimensions",
              "position"
            ]
          }
        },
        "graphs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "graphName": {
                "type": "string"
              },
              "graphType": {
                "type": "string"
              },
              "marks": {
                "type": "boolean"
              },
              "lineColor": {
                "type": "string"
              },
              "lineWidth": {
                "type": "string"
              },
              "markColor": {
                "type": "string"
              },
              "markWidth": {
                "type": "number"
              }
            },
            "required": [
              "graphType",
              "marks",
              "lineColor",
              "lineWidth",
              "lineStyle",
              "markColor",
              "markWidth"
            ]
          }
        }
      },
      "required": [
        "visible",
        "dimensions",
        "preferredSize",
        "position"
      ]
    }
  },
  "type": "object",
  "properties": {
    "TIMEOUT": {
      "configDescription": "DESC_TIMEOUT",
      "type": "string",
      "propertyOrder": 2,
      "format": "timespan",
      "default": "PT5S",
      "formatMinimum": "PT5S"
    },
    "CHUNKSIZE": {
      "configDescription": "DESC_CHUNKSIZE",
      "type": "integer",
      "propertyOrder": 2,
      "default": 1048576,
      "unit": "byte",
      "minimum": 1
    },
    "COMPRESSION": {
      "configDescription": "DESC_COMPRESSION",
      "type": "boolean",
      "propertyOrder": 2,
      "default": true
    },
    "scopeRecords": {
      "configDescription": "DESC_SCOPE_RECORDS",
      "visibility": "HideInEngineering",
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scopeConfigName": {
            "type": "string"
          },
          "headlessServerConnectionId": {
            "type": "string"
          },
          "headlessServer": {
            "type": "string"
          },
          "targetConnectionIds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "targetNetId": {
                  "type": "string"
                },
                "connectionId": {
                  "type": "integer"
                }
              },
              "required": [
                "connectionId",
                "target",
                "targetNetId"
              ]
            }
          },
          "serverHandles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "guid": {
                  "type": "string"
                },
                "serverHandle": {
                  "type": "integer"
                }
              },
              "required": [
                "guid",
                "serverHandle"
              ]
            }
          },
          "triggerHandles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "guid": {
                  "type": "string"
                },
                "groupHandle": {
                  "type": "integer"
                },
                "clientTriggerHandle": {
                  "type": "integer"
                }
              },
              "required": [
                "guid",
                "groupHandle",
                "clientTriggerHandle"
              ]
            }
          }
        },
        "required": [
          "scopeConfigName",
          "headlessServerConnectionId",
          "serverHandles",
          "triggerHandles",
          "targetConnectionIds"
        ]
      }
    },
    "scopeConfigs": {
      "configDescription": "DESC_SCOPE_CONFIGS",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "AUTOSTART_RECORD": {
            "type": "boolean",
            "default": true
          },
          "CONFIG_SOURCE": {
            "visibility": "HideInEngineering",
            "type": "string",
            "enum": [
              "project",
              "file"
            ]
          },
          "CONFIG_PATH": {
            "visibility": "HideInEngineering",
            "type": "string"
          },
          "CONFIG_FILE": {
            "type": "string",
            "format": "base64"
          }
        },
        "required": [
          "CONFIG_FILE",
          "AUTOSTART_RECORD"
        ]
      }
    },
    "extensionHostMaxReloads": {
      "configDescription": "DESC_EXTENSION_HOST_MAX_RELOADS",
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "extensionHostReloadInterval": {
      "configDescription": "DESC_EXTENSION_HOST_RELOAD_INTERVAL",
      "type": "string",
      "format": "timespan",
      "default": "PT10S"
    }
  },
  "required": [
    "TIMEOUT",
    "CHUNKSIZE",
    "COMPRESSION",
    "scopeConfigs",
    "scopeRecords"
  ]
}
